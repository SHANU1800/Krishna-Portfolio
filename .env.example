# Optional backend form / webhook URL (e.g. n8n Webhook URL, Formspree endpoint, or Web3Forms)
# Leave blank to use the built-in client inquiry fallback (prefilled email + clipboard copy).
VITE_FORM_ENDPOINT=

# Optional confirmed WhatsApp number in international format without + or spaces (e.g. 919934133109)
# Leave blank to show the configurable placeholder until confirmed.
VITE_WHATSAPP_NUMBER=

